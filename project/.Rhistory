seq <- aln$ali["O_rubescens_novel", ]
seq_clean <- seq[seq != "-"]
blast_results <- blast.pdb(seq_clean)
plot(blast_results)
head(blast_results$hit.tbl, 10)
top_hits <- c("2WG4_A", "2WFX_A", "3N1R_A")
anno <- pdb.annotate(top_hits)
anno[, c("structureId", "experimentalTechnique", "resolution", "source")]
