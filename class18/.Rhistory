# Compute mean trend per group per time point
trend <- abdata.21 %>%
filter(isotype == "IgG", antigen == "PT") %>%
group_by(infancy_vac, planned_day_relative_to_boost) %>%
summarise(mean_MFI = mean(MFI_normalised), .groups = "drop")
# Plot individual lines + pre-computed trend
abdata.21 %>%
filter(isotype == "IgG", antigen == "PT") %>%
ggplot(aes(x = planned_day_relative_to_boost,
y = MFI_normalised,
col = infancy_vac)) +
geom_point(alpha = 0.3) +
geom_line(aes(group = subject_id), alpha = 0.3) +
geom_line(data = trend, aes(y = mean_MFI, group = infancy_vac),
linewidth = 1.5) +
geom_point(data = trend, aes(y = mean_MFI), size = 3) +
geom_vline(xintercept = 0, linetype = "dashed") +
geom_vline(xintercept = 14, linetype = "dashed") +
labs(title = "2021 dataset IgG PT",
subtitle = "Bold lines show mean MFI per time point per vaccine group")
# Compute group means
trend <- abdata.21 %>%
filter(isotype == "IgG", antigen == "PT") %>%
group_by(infancy_vac, planned_day_relative_to_boost) %>%
summarise(mean_MFI = mean(MFI_normalised), .groups = "drop")
# Spline interpolation per group
trend_smooth <- trend %>%
group_by(infancy_vac) %>%
reframe({
spl <- spline(planned_day_relative_to_boost, mean_MFI, n = 200)
tibble(planned_day_relative_to_boost = spl$x,
mean_MFI = pmax(spl$y, 0))
})
# Plot
abdata.21 %>%
filter(isotype == "IgG", antigen == "PT") %>%
ggplot(aes(x = planned_day_relative_to_boost,
y = MFI_normalised,
col = infancy_vac)) +
geom_point(alpha = 0.3) +
geom_line(aes(group = subject_id), alpha = 0.3) +
geom_line(data = trend_smooth, aes(y = mean_MFI, group = infancy_vac),
linewidth = 1.5) +
geom_vline(xintercept = 0, linetype = "dashed") +
geom_vline(xintercept = 14, linetype = "dashed") +
labs(title = "2021 dataset IgG PT",
subtitle = "Smooth lines show spline-interpolated group means")
