generate_dna <- function(length) {
nuc <- c("A", "T", "G", "C")
sequence <- sample(nuc, size = length, replace = TRUE)
}
generate_dna(5)
generate_dna(5)
generate_dna <- function(length) {
nuc <- c("A", "T", "G", "C")
sequence <- sample(nuc, size = length, replace = TRUE)
return sequence
