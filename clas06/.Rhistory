student1 <- c(100, 100, 100, 100, 100, 100, 100, 90)
student2 <- c(100, NA, 90, 90, 90, 90, 97, 80)
student3 <- c(90, NA, NA, NA, NA, NA, NA, NA)
grade <- function(vector) {
#checks if the vector has NA
if (any(is.na(vector))) {
#if the vector has NA (should be the only one) removes it - then performs avg calculation and returns it
return (mean(vector, na.rm=TRUE))
} else { #if the vector doesn't have NA
#removes the smallest number in the vector
vector <- vector[-which.min(vector)]
#performs avg calculation and returns it
return (mean(vector))
}
grade(student1)
grade(student2)
grade(student3)
}
