grade <- function(vector) {
#replaces all NAs with 0
vector[is.na(vector)] <- 0
#performs a average calculation on a updated vector in which the lowest value has been removed
return (mean(vector[-which.min(vector)]))
}
csv <- read.csv("https://tinyurl.com/gradeinput")
apply(csv, MARGIN=2, FUN=grade())
