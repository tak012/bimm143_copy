data.scaled <- scale(wisc.data)
data.dist <- dist(data.scaled)
wisc.hclust <- hclust(data.dist, method = "complete")
plot(wisc.hclust)
abline(h = 19, col="red", lty=2)
plot(wisc.hclust)
abline(h = 20, col="red", lty=2)
plot(wisc.hclust)
abline(h = 19, col="red", lty=2)
wisc.hclust.clusters <- cutree(wisc.hclust, k = 4)
wisc.hclust.clusters <- cutree(wisc.hclust, k = 4)
table(wisc.hclust.clusters, diagnosis)
wisc.c <- hclust(data.dist, method = "complete")
wisc.s <- hclust(data.dist, method = "single")
wisc.a <- hclust(data.dist, method = "average")
wisc.w <- hclust(data.dist, method = "ward.D2")
table(cutree(wisc.c, k= 4), diagnosis)
table(cutree(wisc.s, k= 4), diagnosis)
table(cutree(wisc.a, k= 4), diagnosis)
table(cutree(wisc.w, k= 4), diagnosis)
