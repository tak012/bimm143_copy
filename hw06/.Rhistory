library(bio3d)
s1 <- read.pdb("4AKE") # kinase with drug
s2 <- read.pdb("1AKE") # kinase no drug
s3 <- read.pdb("1E4Y") # kinase with drug
s1.chainA <- trim.pdb(s1, chain="A", elety="CA")
s2.chainA <- trim.pdb(s2, chain="A", elety="CA")
s3.chainA <- trim.pdb(s1, chain="A", elety="CA")
s1.b <- s1.chainA$atom$b
s2.b <- s2.chainA$atom$b
s3.b <- s3.chainA$atom$b
plotb3(s1.b, sse=s1.chainA, typ="l", ylab="Bfactor")
plotb3(s2.b, sse=s2.chainA, typ="l", ylab="Bfactor")
plotb3(s3.b, sse=s3.chainA, typ="l", ylab="Bfactor")
analyze_pdb <- function(pdb_id, chain="A") {
pdb <- read.pdb(pdb_id)
trimmed <- trim.pdb(pdb, chain=chain, elety="CA")
bfactors <- trimmed$atom$b
plotb3(bfactors, sse=trimmed, typ="l", ylab="Bfactor")
}
analyze_pdb(c("4AKE", "1AKE", "1E4Y"))
analyze_pdb <- function(pdb_id, chain="A") {
pdb <- read.pdb(pdb_id)
trimmed <- trim.pdb(pdb, chain=chain, elety="CA")
bfactors <- trimmed$atom$b
plotb3(bfactors, sse=trimmed, typ="l", ylab="Bfactor")
}
analyze_pdb(c("4AKE", "1AKE", "1E4Y"), chain="A")
analyze_pdb <- function(pdb_id, chain="A") {
pdb <- read.pdb(pdb_id)
trimmed <- trim.pdb(pdb, chain=chain, elety="CA")
bfactors <- trimmed$atom$b
plotb3(bfactors, sse=trimmed, typ="l", ylab="Bfactor")
return (bfactors)
}
analyze_pdb(c("4AKE", "1AKE", "1E4Y"), chain="A")
analyze_pdb <- function(pdb_id, chain="A") {
pdb <- read.pdb(pdb_id)
trimmed <- trim.pdb(pdb, chain=chain, elety="CA")
bfactors <- trimmed$atom$b
plotb3(bfactors, sse=trimmed, typ="l", ylab="Bfactor")
}
ids <- c("4AKE", "1AKE", "1E4Y")
labels <- c("kinase with drug", "kinase no drug", "kinase with drug")
analyze_pdb(ids, labels=labels)
analyze_pdb <- function(pdb_id, chain="A") {
pdb <- read.pdb(pdb_id)
trimmed <- trim.pdb(pdb, chain=chain, elety="CA")
bfactors <- trimmed$atom$b
plotb3(bfactors, sse=trimmed, typ="l", ylab="Bfactor")
}
analyze_pdb("4AKE")
analyze_pdb("1AKE")
analyze_pdb("1E4Y")
